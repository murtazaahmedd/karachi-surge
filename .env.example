# Free key: https://developer.tomtom.com (freemium tier is ~2500 non-tile requests/day)
TOMTOM_API_KEY=

CITY=karachi

# Host-side defaults (containers override these in docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:19092
PG_DSN=postgresql://surge:surge@localhost:5433/surge

# 15 corridors every 600s = 2160 requests/day, inside the TomTom free tier
TRAFFIC_POLL_SECONDS=600
WEATHER_POLL_SECONDS=900
